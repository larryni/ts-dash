# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env

# Auth key that registers the "ts-dash" machine on the tailnet. Needed on the first start only.
# Admin console > Settings > Keys > "Generate auth key" (a one-off key is fine). It starts with
# tskey-auth-. NOT the API access token (tskey-api-...). Delete the value once the machine shows up.
TS_AUTHKEY=

# Optional. The API access token (tskey-api-...) is normally entered in the dashboard's web page
# on first use and saved in the data volume. Set it here only to skip that step.
# TS_API_KEY=

# Optional
# POLL_SECONDS=60
# TS_TAILNET=-
# PROBE_PORTS=1
# ARCHIVE_RETENTION_DAYS=0
