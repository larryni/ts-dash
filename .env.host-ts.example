# For docker-compose.host-ts.yml:  cp .env.host-ts.example .env && chmod 600 .env
# This machine's tailnet IP (run: tailscale ip -4). The dashboard is only published on it.
BIND_IP=100.x.y.z
# PORT=8080

# Optional. Normally the API token is entered in the web page on first use.
# TS_API_KEY=
# Any other setting from the README's configuration table can go here too, e.g. CATEGORIES=...
